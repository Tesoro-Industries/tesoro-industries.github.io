// {{ ansible_managed }}
// Origins are Ubuntu's defaults from 50unattended-upgrades (security pocket).
Unattended-Upgrade::Automatic-Reboot "{{ 'true' if unattended_upgrades_reboot | bool else 'false' }}";
Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
Unattended-Upgrade::Automatic-Reboot-Time "{{ unattended_upgrades_reboot_time }}";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
