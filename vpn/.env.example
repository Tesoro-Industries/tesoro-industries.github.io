# Copy to .env (git-ignored) and fill in. Loaded by the Makefile and bin/vpn.
# See docs/adr/0008-secrets-and-local-state.md for where each secret lives.

# DigitalOcean API token with read+write scope.
# Create at: DigitalOcean console -> API -> Tokens. Used only by Terraform.
DIGITALOCEAN_TOKEN=

# age recipient (PUBLIC key, starts with "age1...") that backups are encrypted to.
# Generate once:  age-keygen -o ~/vpn-backup-identity.txt
# Keep the identity file in your password manager, NOT in this repo.
VPN_AGE_RECIPIENT=

# Path to the age identity (PRIVATE key) used only by `vpn restore`.
# Optional; you can also pass --identity on the command line.
VPN_AGE_IDENTITY=
