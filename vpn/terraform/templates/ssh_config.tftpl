# Generated by Terraform. Used by Ansible and bin/vpn: ssh -F local/ssh_config vpn
Host vpn
  HostName ${host_ip}
  User ${admin_user}
%{ if identity_file != "" ~}
  IdentityFile ${identity_file}
  IdentitiesOnly yes
%{ endif ~}
  UserKnownHostsFile ${known_hosts_file}
  # Trust-on-first-use. Verify the fingerprint once (README, step 5).
  StrictHostKeyChecking accept-new
  ServerAliveInterval 30
